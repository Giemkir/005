@section Scripts {
    <script>
        // Slider ve filtreleme işlemleri için JavaScript kodları buraya eklenebilir
        document.addEventListener('DOMContentLoaded', function() {
            // Slider kontrolleri
            const prevBtn = document.querySelector('.prev-btn');
            const nextBtn = document.querySelector('.next-btn');
            const slider = document.querySelector('.featured-guides-slider');
            
            if (prevBtn && nextBtn && slider) {
                // Slider işlevselliği burada eklenebilir
            }
            
            // Filtreleme işlevselliği burada eklenebilir
            const filterBtn = document.querySelector('.filter-btn');
            if (filterBtn) {
                filterBtn.addEventListener('click', function() {
                    // Filtreleme işlemleri
                });
            }
        });
    </script>
} 