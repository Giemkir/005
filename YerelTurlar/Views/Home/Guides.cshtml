@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Filtreleme işlevselliği
            const filterBtn = document.querySelector('.filter-btn');
            if (filterBtn) {
                filterBtn.addEventListener('click', function() {
                    // Filtreleme işlemleri burada yapılacak
                    console.log('Filtreleme yapılıyor...');
                    
                    // Örnek: Seçilen değerleri al
                    const location = document.getElementById('location').value;
                    const specialty = document.getElementById('specialty').value;
                    const language = document.getElementById('language').value;
                    
                    console.log('Seçilen filtreler:', { location, specialty, language });
                    
                    // Burada gerçek filtreleme işlemleri yapılabilir
                    // Şimdilik sadece bir bildirim gösterelim
                    alert('Filtreleme özelliği henüz aktif değildir. Seçilen filtreler: ' + 
                          'Şehir: ' + (location || 'Tümü') + 
                          ', Uzmanlık: ' + (specialty || 'Tümü') + 
                          ', Dil: ' + (language || 'Tümü'));
                });
            }
            
            // Rehber kartları için hover efektleri
            const guideCards = document.querySelectorAll('.featured-guide-card');
            guideCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-10px)';
                });
                
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });
        });
    </script>
} 