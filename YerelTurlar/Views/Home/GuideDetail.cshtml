@{
    ViewData["Title"] = "Rehber Detayı";
}

@section Styles {
    <link rel="stylesheet" href="~/css/guide-detail.css" />
}

<section class="guide-profile-header">
    <div class="container">
        <div class="guide-profile-card">
            <div class="guide-profile-image">
                <img src="https://randomuser.me/api/portraits/men/75.jpg" alt="Ahmet Yılmaz">
                <div class="guide-badge top">Top Rehber</div>
            </div>
            <div class="guide-profile-info">
                <h1>Ahmet Yılmaz</h1>
                <p class="guide-location"><i class="fas fa-map-marker-alt"></i> İstanbul, Türkiye</p>
                <p class="guide-specialty">Denizcilik Uzmanı & Tarih Tutkunu</p>
                <div class="guide-stats">
                    <div class="stat">
                        <span class="stat-value">5</span>
                        <span class="stat-label">Yıl Deneyim</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">6</span>
                        <span class="stat-label">Tur Sayısı</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">1250+</span>
                        <span class="stat-label">Misafir</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">4.9</span>
                        <span class="stat-label">Puan (128)</span>
                    </div>
                </div>
                <div class="guide-languages">
                    <h3>Konuştuğu Diller</h3>
                    <div class="language-tags">
                        <span class="language-tag">
                            <img src="https://cdn.jsdelivr.net/npm/flag-icon-css@3.5.0/flags/4x3/tr.svg" alt="Türkçe">
                            Türkçe (Anadil)
                        </span>
                        <span class="language-tag">
                            <img src="https://cdn.jsdelivr.net/npm/flag-icon-css@3.5.0/flags/4x3/gb.svg" alt="İngilizce">
                            İngilizce (Akıcı)
                        </span>
                        <span class="language-tag">
                            <img src="https://cdn.jsdelivr.net/npm/flag-icon-css@3.5.0/flags/4x3/de.svg" alt="Almanca">
                            Almanca (Orta)
                        </span>
                    </div>
                </div>
                <div class="guide-actions">
                    <button class="contact-btn"><i class="fas fa-envelope"></i> Mesaj Gönder</button>
                    <button class="favorite-btn"><i class="far fa-heart"></i> Favorilere Ekle</button>
                    <button class="share-btn"><i class="fas fa-share-alt"></i> Paylaş</button>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="guide-details">
    <div class="container">
        <div class="guide-details-content">
            <div class="guide-about">
                <h2>Hakkında</h2>
                <p>Merhaba, ben Ahmet! İstanbul'da doğdum ve büyüdüm. Denizcilik ve tarih tutkumu birleştirerek, 5 yıldır İstanbul Boğazı'nda rehberlik yapıyorum. İstanbul Üniversitesi Tarih Bölümü mezunuyum ve aynı zamanda profesyonel bir kaptanım.</p>
                <p>Boğaz'ın her köşesini, her akıntısını ve her yapısını tanıyorum. Misafirlerime sadece turistik rotaları değil, İstanbul'un gizli kalmış köşelerini, yerel lezzetlerini ve gerçek hikayelerini sunmayı seviyorum.</p>
                <p>Turlarımda, İstanbul'un iki kıta arasındaki eşsiz konumunu, Bizans'tan Osmanlı'ya ve günümüze uzanan zengin tarihini ve kültürünü anlatırken, aynı zamanda denizcilik hikayeleri ve boğazın sırlarını da paylaşıyorum.</p>
                
                <h3>Uzmanlık Alanları</h3>
                <div class="expertise-tags">
                    <span>Boğaz Tarihi</span>
                    <span>Denizcilik</span>
                    <span>Osmanlı Tarihi</span>
                    <span>Yerel Gastronomi</span>
                    <span>Fotoğrafçılık</span>
                </div>
                
                <h3>Eğitim & Sertifikalar</h3>
                <ul class="certificates-list">
                    <li><i class="fas fa-graduation-cap"></i> İstanbul Üniversitesi, Tarih Bölümü</li>
                    <li><i class="fas fa-certificate"></i> Profesyonel Turizm Rehberliği Sertifikası</li>
                    <li><i class="fas fa-ship"></i> Amatör Denizci Belgesi</li>
                    <li><i class="fas fa-first-aid"></i> İlk Yardım Sertifikası</li>
                </ul>
            </div>
            
            <div class="guide-tours">
                <h2>Ahmet'in Turları</h2>
                <div class="guide-tours-grid">
                    <div class="experience-card">
                        <img src="https://images.unsplash.com/photo-1570654621852-9dd25b76b38d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=687&q=80" alt="Boğaz Turu">
                        <div class="card-content">
                            <span class="price">₺450 / kişi</span>
                            <h3>Boğaz'da Gün Batımı Yat Turu</h3>
                            <p class="description">İstanbul Boğazı'nın eşsiz manzarasını gün batımında keşfedin. Yerel lezzetler eşliğinde, tarihi yarımadanın panoramik görüntüsünü yakalayın.</p>
                            <p class="rating"><i class="fas fa-star"></i> 4.9 (128 değerlendirme)</p>
                            <p class="duration"><i class="far fa-clock"></i> 3 saat</p>
                            <a href="#" class="book-btn">Rezervasyon Yap</a>
                        </div>
                    </div>
                    
                    <div class="experience-card">
                        <img src="https://images.unsplash.com/photo-1527838832700-5059252407fa?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=698&q=80" alt="Tarihi Yarımada">
                        <div class="card-content">
                            <span class="price">₺350 / kişi</span>
                            <h3>Tarihi Yarımada Yürüyüş Turu</h3>
                            <p class="description">Ayasofya, Topkapı Sarayı, Sultanahmet Camii ve daha fazlasını içeren bu turda İstanbul'un 2500 yıllık tarihini keşfedin.</p>
                            <p class="rating"><i class="fas fa-star"></i> 4.8 (95 değerlendirme)</p>
                            <p class="duration"><i class="far fa-clock"></i> 4 saat</p>
                            <a href="#" class="book-btn">Rezervasyon Yap</a>
                        </div>
                    </div>
                    
                    <div class="experience-card">
                        <img src="https://images.unsplash.com/photo-1541432901042-2d8bd64b4a9b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1158&q=80" alt="Adalar Turu">
                        <div class="card-content">
                            <span class="price">₺500 / kişi</span>
                            <h3>Prens Adaları Tekne Turu</h3>
                            <p class="description">İstanbul'un sakin adalarını keşfedin. Büyükada, Heybeliada ve Kınalıada'yı ziyaret edin, yüzün ve yerel lezzetleri tadın.</p>
                            <p class="rating"><i class="fas fa-star"></i> 4.7 (82 değerlendirme)</p>
                            <p class="duration"><i class="far fa-clock"></i> 7 saat</p>
                            <a href="#" class="book-btn">Rezervasyon Yap</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

