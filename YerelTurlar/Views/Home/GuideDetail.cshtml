@section Scripts {
    <script>
        // Yorum yükleme ve diğer etkileşimler için JavaScript kodları buraya eklenebilir
        document.addEventListener('DOMContentLoaded', function() {
            const loadMoreBtn = document.querySelector('.load-more-btn');
            if (loadMoreBtn) {
                loadMoreBtn.addEventListener('click', function() {
                    // Daha fazla yorum yükleme işlevi
                    console.log('Daha fazla yorum yükleniyor...');
                });
            }
            
            // Favorilere ekleme işlevi
            const favoriteBtn = document.querySelector('.favorite-btn');
            if (favoriteBtn) {
                favoriteBtn.addEventListener('click', function() {
                    const icon = this.querySelector('i');
                    if (icon.classList.contains('far')) {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                        console.log('Favorilere eklendi');
                    } else {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                        console.log('Favorilerden çıkarıldı');
                    }
                });
            }
        });
    </script>
} 