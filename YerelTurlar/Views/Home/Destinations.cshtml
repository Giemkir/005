@{
    ViewData["Title"] = "Destinasyonlar";
}

@section Styles {
    <link rel="stylesheet" href="~/css/destinations.css" />
}

<section class="page-hero">
    <div class="page-hero-image">
        <img src="https://images.unsplash.com/photo-1530841377377-3ff06c0ca713?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1170&q=80" alt="Türkiye Destinasyonları">
        <div class="page-hero-overlay"></div>
    </div>
    <div class="container">
        <div class="page-hero-content">
            <h1>Türkiye'nin Büyüleyici Destinasyonları</h1>
            <p>Tarihi zenginlikler, doğal güzellikler ve eşsiz kültürel deneyimler sunan destinasyonları keşfedin</p>
        </div>
    </div>
</section>

<section class="destinations-filter">
    <div class="container">
        <div class="filter-container">
            <div class="filter-group">
                <label for="region">Bölge</label>
                <select id="region">
                    <option value="">Tüm Bölgeler</option>
                    <option value="marmara">Marmara</option>
                    <option value="ege">Ege</option>
                    <option value="akdeniz">Akdeniz</option>
                    <option value="ic-anadolu">İç Anadolu</option>
                    <option value="karadeniz">Karadeniz</option>
                    <option value="dogu-anadolu">Doğu Anadolu</option>
                    <option value="guneydogu-anadolu">Güneydoğu Anadolu</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="category">Kategori</label>
                <select id="category">
                    <option value="">Tüm Kategoriler</option>
                    <option value="kultur">Kültür</option>
                    <option value="yemek">Yemek</option>
                    <option value="doga">Doğa</option>
                    <option value="spor">Spor</option>
                    <option value="fotograf">Fotoğraf</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="duration">Süre</label>
                <select id="duration">
                    <option value="">Tüm Süreler</option>
                    <option value="1-3">1-3 Saat</option>
                    <option value="3-6">3-6 Saat</option>
                    <option value="6-12">6-12 Saat</option>
                    <option value="full-day">Tam Gün</option>
                    <option value="multi-day">Çok Günlü</option>
                </select>
            </div>
            <button class="filter-btn">Filtrele</button>
        </div>
    </div>
</section>

<section class="featured-destinations">
    <div class="container">
        <div class="section-title-container destinations-title-container">
            <div class="tag-container">
                <span class="section-subtitle destinations-subtitle">ÖNE ÇIKANLAR</span>
            </div>
            <h2>Popüler Destinasyonlar</h2>
            <p class="section-description">Türkiye'nin en çok ziyaret edilen ve beğenilen destinasyonlarını keşfedin.</p>
            <span class="title-separator"></span>
        </div>
        
        <div class="featured-destination-cards">
            <div class="featured-destination-card">
                <div class="featured-destination-image">
                    <img src="https://images.unsplash.com/photo-1527838832700-5059252407fa?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=698&q=80" alt="İstanbul">
                    <div class="destination-overlay"></div>
                    <div class="destination-badge">
                        <span>42 Deneyim</span>
                    </div>
                </div>
                <div class="featured-destination-content">
                    <h3>İstanbul</h3>
                    <p>İki kıtayı birleştiren, tarihi ve modern yüzüyle büyüleyen şehir</p>
                    <div class="destination-categories">
                        <span><i class="fas fa-landmark"></i> Kültür</span>
                        <span><i class="fas fa-utensils"></i> Yemek</span>
                        <span><i class="fas fa-camera"></i> Fotoğraf</span>
                    </div>
                    <a href="#" class="destination-link">Deneyimleri Keşfet <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>
            <div class="featured-destination-card">
                <div class="featured-destination-image">
                    <img src="https://images.unsplash.com/photo-1549740425-5e9ed4d8cd34?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Kapadokya">
                    <div class="destination-overlay"></div>
                    <div class="destination-badge">
                        <span>28 Deneyim</span>
                    </div>
                </div>
                <div class="featured-destination-content">
                    <h3>Kapadokya</h3>
                    <p>Peri bacaları, sıcak hava balonları ve yeraltı şehirleriyle masalsı bir deneyim</p>
                    <div class="destination-categories">
                        <span><i class="fas fa-mountain"></i> Doğa</span>
                        <span><i class="fas fa-landmark"></i> Kültür</span>
                        <span><i class="fas fa-camera"></i> Fotoğraf</span>
                    </div>
                    <a href="#" class="destination-link">Deneyimleri Keşfet <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>

