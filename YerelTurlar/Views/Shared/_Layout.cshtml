<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - YerelTurlar</title>
    <link rel="stylesheet" href="~/css/styles.css" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index">
                    <h1><i class="fas fa-globe-americas"></i> YerelTurlar</h1>
                </a>
            </div>
            <nav>
                <ul class="main-menu">
                    <li><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                    <li class="dropdown">
                        <a href="#">Kategoriler <i class="fas fa-chevron-down"></i></a>
                        <ul class="dropdown-menu">
                            <li><a href="#"><i class="fas fa-landmark"></i> Kültür</a></li>
                            <li><a href="#"><i class="fas fa-utensils"></i> Yemek</a></li>
                            <li><a href="#"><i class="fas fa-mountain"></i> Doğa</a></li>
                            <li><a href="#"><i class="fas fa-running"></i> Spor</a></li>
                            <li><a href="#"><i class="fas fa-camera"></i> Fotoğraf</a></li>
                        </ul>
                    </li>
                    <li><a asp-controller="Home" asp-action="Destinations">Destinasyonlar</a></li>
                    <li><a asp-controller="Home" asp-action="Guides">Rehberler</a></li>
                    <li><a asp-controller="Home" asp-action="About">Hakkımızda</a></li>
                </ul>
                <ul class="user-menu">
                    <li><a asp-controller="Account" asp-action="Login">Giriş Yap</a></li>
                    <li><a asp-controller="Account" asp-action="Register" class="signup-btn">Kayıt Ol</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Bildirim Bölümü -->
    @if (TempData["SubscribeSuccess"] != null)
    {
        <div class="notification success">
            <div class="container">
                <div class="notification-content">
                    <i class="fas fa-check-circle"></i>
                    <p>@TempData["SubscribeSuccess"]</p>
                    <button class="notification-close"><i class="fas fa-times"></i></button>
                </div>
            </div>
        </div>
    }
    
    @if (TempData["SubscribeError"] != null)
    {
        <div class="notification error">
            <div class="container">
                <div class="notification-content">
                    <i class="fas fa-exclamation-circle"></i>
                    <p>@TempData["SubscribeError"]</p>
                    <button class="notification-close"><i class="fas fa-times"></i></button>
                </div>
            </div>
        </div>
    }

    @RenderBody()

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
