<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YerelTurlar Admin</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    
    <!-- CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="admin-sidebar-header">
                <div class="admin-logo">
                    <h2>YerelTurlar</h2>
                </div>
                <div class="admin-sidebar-close">
                    <i class="fas fa-times"></i>
                </div>
            </div>
            
            <div class="admin-user-info">
                <div class="admin-avatar">
                    <i class="fas fa-user-circle"></i>
                </div>
                <div class="admin-user-details">
                    <p class="admin-name">@Context.Session.GetString("AdminName")</p>
                    <p class="admin-role">Yönetici</p>
                </div>
            </div>
            
            <nav class="admin-nav">
                <ul>
                    <li>
                        <a asp-controller="Admin" asp-action="Dashboard" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Dashboard" ? "active" : "")">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Users" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Users" ? "active" : "")">
                            <i class="fas fa-users"></i> Kullanıcılar
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Categories" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Categories" ? "active" : "")">
                            <i class="fas fa-list"></i> Kategoriler
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Tours" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Tours" ? "active" : "")">
                            <i class="fas fa-map-marked-alt"></i> Turlar
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Reviews" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Reviews" ? "active" : "")">
                            <i class="fas fa-star"></i> Değerlendirmeler
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Bookings" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Bookings" ? "active" : "")">
                            <i class="fas fa-calendar-alt"></i> Rezervasyonlar
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Settings" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Settings" ? "active" : "")">
                            <i class="fas fa-cog"></i> Ayarlar
                        </a>
                    </li>
                    <li>
                        <a href="/" target="_blank">
                            <i class="fas fa-external-link-alt"></i> Siteye Dön
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Logout">
                            <i class="fas fa-sign-out-alt"></i> Çıkış Yap
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>
        
        <!-- Main Content -->
        <main class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar">
                <button class="sidebar-toggle">
                    <i class="fas fa-bars"></i>
                </button>
                
                <div class="admin-search">
                    <form>
                        <input type="text" placeholder="Arama yapın..." />
                        <button type="button">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                </div>
                
                <div class="admin-topbar-right">
                    <div class="admin-notification">
                        <i class="fas fa-bell"></i>
                        <span class="notification-count">3</span>
                        
                        <!-- Notification Dropdown (hidden by default) -->
                        <div class="dropdown-menu dropdown-menu-end shadow">
                            <h6 class="dropdown-header">Bildirim Merkezi</h6>
                            <a class="dropdown-item d-flex align-items-center" href="#">
                                <div class="mr-3">
                                    <div class="icon-circle bg-primary">
                                        <i class="fas fa-user-plus text-white"></i>
                                    </div>
                                </div>
                                <div>
                                    <div class="small text-gray-500">15 Mart 2025</div>
                                    <span>Yeni kullanıcı kaydı yapıldı</span>
                                </div>
                            </a>
                            <a class="dropdown-item d-flex align-items-center" href="#">
                                <div class="mr-3">
                                    <div class="icon-circle bg-success">
                                        <i class="fas fa-check text-white"></i>
                                    </div>
                                </div>
                                <div>
                                    <div class="small text-gray-500">14 Mart 2025</div>
                                    <span>Yeni rezervasyon tamamlandı</span>
                                </div>
                            </a>
                            <a class="dropdown-item d-flex align-items-center" href="#">
                                <div class="mr-3">
                                    <div class="icon-circle bg-warning">
                                        <i class="fas fa-exclamation-triangle text-white"></i>
                                    </div>
                                </div>
                                <div>
                                    <div class="small text-gray-500">13 Mart 2025</div>
                                    <span>Sistem uyarısı</span>
                                </div>
                            </a>
                            <a class="dropdown-item text-center small text-gray-500" href="#">Tüm Bildirimleri Göster</a>
                        </div>
                    </div>
                    
                    <div class="admin-profile">
                        <i class="fas fa-user-circle"></i>
                        <span>@Context.Session.GetString("AdminName")</span>
                        
                        <!-- Profile Dropdown -->
                        <div class="dropdown-menu dropdown-menu-end shadow">
                            <a class="dropdown-item" href="#">
                                <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                Profil
                            </a>
                            <a class="dropdown-item" href="#">
                                <i class="fas fa-cogs fa-sm fa-fw mr-2 text-gray-400"></i>
                                Ayarlar
                            </a>
                            <a class="dropdown-item" href="#">
                                <i class="fas fa-list fa-sm fa-fw mr-2 text-gray-400"></i>
                                Aktivite Günlüğü
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="@Url.Action("Logout", "Admin")">
                                <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                Çıkış Yap
                            </a>
                        </div>
                    </div>
                </div>
            </header>
            
            <!-- Content -->
            <div class="admin-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
            
            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; YerelTurlar Admin Panel 2025</span>
                    </div>
                </div>
            </footer>
        </main>
    </div>
    
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/admin.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 