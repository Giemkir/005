@model YerelTurlar.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "_AuthLayout";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-container">
            <div class="auth-content">
                <div class="auth-header">
                    <h1>Şifremi Unuttum</h1>
                    <p>Şifrenizi sıfırlamak için lütfen e-posta adresinizi girin.</p>
                </div>
                
                <form class="auth-form" asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <div class="form-group">
                        <label asp-for="Email">E-posta Adresi</label>
                        <div class="input-with-icon">
                            <i class="fas fa-envelope"></i>
                            <input asp-for="Email" type="email" placeholder="E-posta adresinizi girin" required>
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    
                    <button type="submit" class="auth-btn">
                        Şifremi Sıfırla <i class="fas fa-arrow-right"></i>
                    </button>
                </form>
                
                <div class="auth-footer">
                    <p>Şifrenizi hatırladınız mı? <a asp-controller="Account" asp-action="Login">Giriş Yap</a></p>
                </div>
            </div>
            
            <div class="auth-image">
                <img src="https://images.unsplash.com/photo-1590601486787-1cc69c2bb8fc?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Türkiye">
                <div class="auth-image-overlay"></div>
                <div class="auth-image-content">
                    <h2>Hesabınıza Tekrar Erişin</h2>
                    <p>Şifrenizi sıfırlayarak hesabınıza kolayca erişin.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 