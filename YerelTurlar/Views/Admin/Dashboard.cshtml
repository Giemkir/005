@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<!-- Demo Giriş Bildirimi -->
@if (ViewBag.IsDemoLogin)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <div class="d-flex align-items-center">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Demo mod aktif!</strong> &nbsp; Şu anda demo hesap ile yönetici panelini kullanıyorsunuz.
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Dashboard Başlık ve Özet -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
        <p class="text-muted">Yerel Turlar portalına hoş geldiniz, tüm istatistikleri ve içerikleri buradan yönetebilirsiniz.</p>
    </div>
    <a href="#" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <i class="fas fa-download fa-sm text-white-50 me-2"></i>Rapor Oluştur
    </a>
</div>

<!-- İstatistik Kartları -->
<div class="row dashboard-stats">
    <!-- Toplam Kullanıcı -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card card-primary">
            <div class="stat-card-header">
                <h3>Kullanıcılar</h3>
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-card-body">
                <p class="stat-number">@ViewBag.TotalUsers</p>
            </div>
            <div class="stat-card-footer">
                <a asp-controller="Admin" asp-action="Users">Tüm Kullanıcılar <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <!-- Toplam Kategori -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card card-success">
            <div class="stat-card-header">
                <h3>Kategoriler</h3>
                <i class="fas fa-list"></i>
            </div>
            <div class="stat-card-body">
                <p class="stat-number">@ViewBag.TotalCategories</p>
            </div>
            <div class="stat-card-footer">
                <a asp-controller="Admin" asp-action="Categories">Tüm Kategoriler <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <!-- Toplam Tur -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card card-info">
            <div class="stat-card-header">
                <h3>Turlar</h3>
                <i class="fas fa-map-marked-alt"></i>
            </div>
            <div class="stat-card-body">
                <p class="stat-number">@ViewBag.TotalTours</p>
            </div>
            <div class="stat-card-footer">
                <a asp-controller="Admin" asp-action="Tours">Tüm Turlar <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <!-- Toplam Değerlendirme -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card card-warning">
            <div class="stat-card-header">
                <h3>Değerlendirmeler</h3>
                <i class="fas fa-star"></i>
            </div>
            <div class="stat-card-body">
                <p class="stat-number">@ViewBag.TotalReviews</p>
            </div>
            <div class="stat-card-footer">
                <a asp-controller="Admin" asp-action="Reviews">Tüm Değerlendirmeler <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

<!-- Grafikler -->
<div class="row">
    <!-- Kullanıcı İstatistikleri Grafiği -->
    <div class="col-xl-8 col-lg-7">
        <div class="dashboard-card mb-4">
            <div class="dashboard-card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h3 class="m-0">Kullanıcı İstatistikleri</h3>
                <div class="dropdown no-arrow">
                    <a class="dropdown-toggle" href="#" role="button" id="userStatsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userStatsDropdown">
                        <a class="dropdown-item" href="#">Bu Ay</a>
                        <a class="dropdown-item" href="#">Bu Çeyrek</a>
                        <a class="dropdown-item" href="#">Bu Yıl</a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#">Tüm İstatistikler</a>
                    </div>
                </div>
            </div>
            <div class="dashboard-card-body">
                <div class="chart-area">
                    <canvas id="userStatsChart" style="height: 320px; width: 100%;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Kategori Dağılımı -->
    <div class="col-xl-4 col-lg-5">
        <div class="dashboard-card mb-4">
            <div class="dashboard-card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h3 class="m-0">Kategori Dağılımı</h3>
                <div class="dropdown no-arrow">
                    <a class="dropdown-toggle" href="#" role="button" id="categoryStatsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="categoryStatsDropdown">
                        <a class="dropdown-item" href="#">Grafik Göster</a>
                        <a class="dropdown-item" href="#">Tablo Göster</a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#">Kategori Düzenle</a>
                    </div>
                </div>
            </div>
            <div class="dashboard-card-body">
                <div class="chart-pie position-relative" style="height: 320px; width: 100%;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- İçerik Satırı -->
<div class="row">
    <!-- Son Kullanıcılar -->
    <div class="col-lg-6 mb-4">
        <div class="dashboard-card">
            <div class="dashboard-card-header py-3">
                <h3 class="m-0">Son Kayıt Olan Kullanıcılar</h3>
            </div>
            <div class="dashboard-card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Kullanıcı</th>
                                <th>Email</th>
                                <th>Kayıt Tarihi</th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.RecentUsers != null && ViewBag.RecentUsers.Count > 0)
                            {
                                @foreach (var user in ViewBag.RecentUsers)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm me-2 bg-primary text-white rounded-circle d-flex justify-content-center align-items-center">
                                                    @(user.FirstName[0])@(user.LastName[0])
                                                </div>
                                                <span>@user.FirstName @user.LastName</span>
                                            </div>
                                        </td>
                                        <td class="align-middle">@user.Email</td>
                                        <td class="align-middle">@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td class="align-middle">
                                            <a href="@Url.Action("EditUser", "Admin", new { id = user.Id })" class="btn btn-sm btn-primary" data-bs-toggle="tooltip" title="Düzenle">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">Kullanıcı bulunmamaktadır.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="dashboard-card-footer py-2 text-center">
                <a href="@Url.Action("Users", "Admin")" class="btn btn-sm btn-primary">
                    Tüm Kullanıcıları Görüntüle
                </a>
            </div>
        </div>
    </div>

    <!-- Son Aktiviteler -->
    <div class="col-lg-6 mb-4">
        <div class="dashboard-card">
            <div class="dashboard-card-header py-3">
                <h3 class="m-0">Son Aktiviteler</h3>
            </div>
            <div class="dashboard-card-body">
                <div class="activity-timeline">
                    <div class="activity-item d-flex mb-3">
                        <div class="activity-icon bg-primary text-white me-3">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <div class="activity-content">
                            <div class="fw-bold">Yeni Kullanıcı Kaydı</div>
                            <div class="small text-muted">@DateTime.Now.AddDays(-1).ToString("dd.MM.yyyy HH:mm")</div>
                            <div>Ahmet Yılmaz sisteme kaydoldu.</div>
                        </div>
                    </div>
                    <div class="activity-item d-flex mb-3">
                        <div class="activity-icon bg-success text-white me-3">
                            <i class="fas fa-check"></i>
                        </div>
                        <div class="activity-content">
                            <div class="fw-bold">Tur Eklendi</div>
                            <div class="small text-muted">@DateTime.Now.AddDays(-2).ToString("dd.MM.yyyy HH:mm")</div>
                            <div>İstanbul Tarihi Yarımada Turu eklendi.</div>
                        </div>
                    </div>
                    <div class="activity-item d-flex mb-3">
                        <div class="activity-icon bg-info text-white me-3">
                            <i class="fas fa-star"></i>
                        </div>
                        <div class="activity-content">
                            <div class="fw-bold">Yeni Değerlendirme</div>
                            <div class="small text-muted">@DateTime.Now.AddDays(-3).ToString("dd.MM.yyyy HH:mm")</div>
                            <div>Kapadokya Turu için yeni bir değerlendirme yapıldı.</div>
                        </div>
                    </div>
                    <div class="activity-item d-flex mb-3">
                        <div class="activity-icon bg-warning text-white me-3">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="activity-content">
                            <div class="fw-bold">Kategori Güncellendi</div>
                            <div class="small text-muted">@DateTime.Now.AddDays(-4).ToString("dd.MM.yyyy HH:mm")</div>
                            <div>Doğa Macerası kategorisi güncellendi.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dashboard-card-footer py-2 text-center">
                <a href="#" class="btn btn-sm btn-primary">
                    Tüm Aktiviteleri Görüntüle
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.1/dist/chart.min.js"></script>
    <script>
        $(document).ready(function() {
            // Kullanıcı İstatistikleri Grafiği
            const userCtx = document.getElementById('userStatsChart').getContext('2d');
            const userChart = new Chart(userCtx, {
                type: 'line',
                data: {
                    labels: ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran'],
                    datasets: [{
                        label: 'Yeni Kullanıcılar',
                        data: [15, 22, 36, 42, 38, 45],
                        backgroundColor: 'rgba(255, 107, 107, 0.05)',
                        borderColor: 'rgba(255, 107, 107, 1)',
                        borderWidth: 2,
                        pointBackgroundColor: '#ff6b6b',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 1,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                drawBorder: false
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
            
            // Kategori Dağılım Grafiği
            const categoryCtx = document.getElementById('categoryChart').getContext('2d');
            const categoryChart = new Chart(categoryCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Kültür Turları', 'Doğa Maceraları', 'Gastronomi', 'Deniz Turları', 'Diğer'],
                    datasets: [{
                        data: [35, 25, 20, 15, 5],
                        backgroundColor: [
                            '#ff6b6b', 
                            '#20c997', 
                            '#17a2b8', 
                            '#ffc107', 
                            '#6c757d'
                        ],
                        hoverBackgroundColor: [
                            '#e74c3c', 
                            '#17a47b', 
                            '#13889b', 
                            '#e6ad06', 
                            '#5a6268'
                        ],
                        hoverBorderColor: "rgba(234, 236, 244, 1)",
                        borderWidth: 0
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 15
                            }
                        }
                    },
                    cutout: '70%'
                }
            });
        });
    </script>
}

@section Styles {
    <style>
        .avatar-sm {
            width: 30px;
            height: 30px;
            font-size: 12px;
        }
        
        .activity-timeline .activity-item {
            position: relative;
        }
        
        .activity-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .chart-area, .chart-pie {
            position: relative;
            height: 100%;
        }
    </style>
} 