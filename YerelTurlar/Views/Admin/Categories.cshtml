@model IEnumerable<YerelTurlar.Models.Category>
@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "_AdminLayout";
}

<!-- Kategoriler Başlık ve Özet -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Kategoriler</h1>
        <p class="text-muted">Tüm tur kategorilerini bu sayfadan yönetebilirsiniz.</p>
    </div>
    <button type="button" class="d-sm-inline-block btn btn-sm btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
        <i class="fas fa-plus fa-sm text-white-50 me-2"></i>Yeni Kategori Ekle
    </button>
</div>

<!-- Kategoriler Tablosu -->
<div class="dashboard-card mb-4">
    <div class="dashboard-card-header py-3">
        <h3 class="m-0">Tüm Kategoriler</h3>
    </div>
    <div class="dashboard-card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover" id="categoriesTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Kategori</th>
                        <th>Açıklama</th>
                        <th>İkon</th>
                        <th>Tur Sayısı</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.Id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(category.ImageUrl))
                                    {
                                        <img src="@category.ImageUrl" class="rounded me-2" width="40" height="40" alt="@category.Name">
                                    }
                                    <span>@category.Name</span>
                                </div>
                            </td>
                            <td>@(category.Description.Length > 50 ? category.Description.Substring(0, 50) + "..." : category.Description)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(category.IconClass))
                                {
                                    <i class="@category.IconClass"></i>
                                }
                            </td>
                            <td>@(category.Tours?.Count ?? 0)</td>
                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td>@category.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="d-flex">
                                    <button type="button" class="btn btn-sm btn-primary me-2" data-bs-toggle="modal" data-bs-target="#editCategoryModal" data-id="@category.Id">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteCategoryModal" data-id="@category.Id">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Kategori Ekle Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCategoryModalLabel">Yeni Kategori Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-controller="Admin" asp-action="AddCategory" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label for="name" class="form-label">Kategori Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="name" name="Name" required>
                    </div>
                    <div class="form-group mb-3">
                        <label for="description" class="form-label">Açıklama</label>
                        <textarea class="form-control" id="description" name="Description" rows="3"></textarea>
                    </div>
                    <div class="form-group mb-3">
                        <label for="iconClass" class="form-label">İkon Kodu</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-icons"></i></span>
                            <input type="text" class="form-control" id="iconClass" name="IconClass" placeholder="örn: fas fa-hiking">
                        </div>
                        <small class="form-text text-muted">Font Awesome ikonları için kod girin (örn: fas fa-hiking)</small>
                    </div>
                    <div class="form-group mb-3">
                        <label for="imageFile" class="form-label">Kategori Görseli</label>
                        <input type="file" class="form-control" id="imageFile" name="ImageFile">
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="isActive" name="IsActive" checked>
                        <label class="form-check-label" for="isActive">
                            Aktif
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kategori Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Kategori Düzenle Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editCategoryModalLabel">Kategori Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-controller="Admin" asp-action="EditCategory" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" id="editId" name="Id">
                    <div class="form-group mb-3">
                        <label for="editName" class="form-label">Kategori Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editName" name="Name" required>
                    </div>
                    <div class="form-group mb-3">
                        <label for="editDescription" class="form-label">Açıklama</label>
                        <textarea class="form-control" id="editDescription" name="Description" rows="3"></textarea>
                    </div>
                    <div class="form-group mb-3">
                        <label for="editIconClass" class="form-label">İkon Kodu</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-icons"></i></span>
                            <input type="text" class="form-control" id="editIconClass" name="IconClass" placeholder="örn: fas fa-hiking">
                        </div>
                        <small class="form-text text-muted">Font Awesome ikonları için kod girin (örn: fas fa-hiking)</small>
                    </div>
                    <div class="form-group mb-3">
                        <label for="editImageFile" class="form-label">Kategori Görseli</label>
                        <input type="file" class="form-control" id="editImageFile" name="ImageFile">
                        <div class="mt-2" id="currentImage">
                            <small class="form-text text-muted">Mevcut görsel: <span id="currentImageName"></span></small>
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="editIsActive" name="IsActive">
                        <label class="form-check-label" for="editIsActive">
                            Aktif
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Kategori Sil Modal -->
<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-labelledby="deleteCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteCategoryModalLabel">Kategoriyi Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p>Bu kategoriyi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
                <p class="text-danger">Uyarı: Bu kategoriye ait turlar var ise, önce bu turları başka bir kategoriye taşımanız veya silmeniz gerekir.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <form asp-controller="Admin" asp-action="DeleteCategory" method="post">
                    <input type="hidden" id="deleteId" name="id">
                    <button type="submit" class="btn btn-danger">Kategoriyi Sil</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#categoriesTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
                },
                order: [[0, 'desc']]
            });
            
            // Kategori düzenleme modalını açarken mevcut verileri doldur
            $('#editCategoryModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var categoryId = button.data('id');
                var modal = $(this);
                
                // AJAX ile kategori bilgilerini çek
                $.ajax({
                    url: '/Admin/GetCategory',
                    type: 'GET',
                    data: { id: categoryId },
                    success: function(data) {
                        modal.find('#editId').val(data.id);
                        modal.find('#editName').val(data.name);
                        modal.find('#editDescription').val(data.description);
                        modal.find('#editIconClass').val(data.iconClass);
                        modal.find('#editIsActive').prop('checked', data.isActive);
                        
                        if (data.imageUrl) {
                            modal.find('#currentImageName').text(data.imageUrl.split('/').pop());
                            modal.find('#currentImage').show();
                        } else {
                            modal.find('#currentImage').hide();
                        }
                    }
                });
            });
            
            // Kategori silme modalını açarken ID'yi doldur
            $('#deleteCategoryModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var categoryId = button.data('id');
                var modal = $(this);
                modal.find('#deleteId').val(categoryId);
            });
        });
    </script>
} 