@model YerelTurlar.Models.User
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    Layout = "_AdminLayout";
}

<div class="dashboard-header">
    <h1>Kullanıcı Düzenle</h1>
    <p>Kullanıcı bilgilerini güncelleyebilirsiniz.</p>
</div>

<div class="dashboard-card">
    <div class="dashboard-card-header">
        <h3>Kullanıcı Bilgileri</h3>
    </div>
    <div class="dashboard-card-body">
        <form asp-action="EditUser" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="FirstName" class="control-label">Ad</label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="LastName" class="control-label">Soyad</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="control-label">E-posta</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Phone" class="control-label">Telefon</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Password" class="control-label">Şifre</label>
                        <input type="password" asp-for="Password" class="form-control" placeholder="Şifreyi değiştirmek için yeni şifre girin" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <small class="form-text text-muted">Değiştirmek istemiyorsanız boş bırakın.</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label class="control-label">Şifre Tekrar</label>
                        <input type="password" name="ConfirmPassword" class="form-control" placeholder="Şifreyi tekrar girin" />
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group form-check mb-3">
                        <input asp-for="IsAdmin" class="form-check-input" />
                        <label asp-for="IsAdmin" class="form-check-label">Admin Yetkisi</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Hesap Aktif</label>
                    </div>
                </div>
            </div>
            
            <div class="form-group">
                <a asp-action="Users" class="btn btn-secondary">İptal</a>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 